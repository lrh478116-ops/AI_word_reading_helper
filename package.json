{
  "name": "ai-tip-document-app",
  "private": true,
  "version": "1.9.3",
  "description": "面向深度阅读的本地 AI 文档与 Tip 对话应用",
  "author": "AI Tip",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b --pretty false",
    "desktop:prepare": "pnpm build && esbuild server/index.ts --bundle --platform=node --format=cjs --target=node20 --external:pyodide --external:pdfjs-dist/* --outfile=dist-electron/server.cjs && esbuild server/python-worker.mjs --bundle --platform=node --format=cjs --target=node20 --external:pyodide --outfile=dist-electron/python-worker.cjs",
    "desktop:dev": "pnpm desktop:prepare && concurrently -k -n web,desktop -c cyan,green \"vite\" \"wait-on http://127.0.0.1:5173 && electron electron/main.mjs --dev\"",
    "desktop:start": "pnpm desktop:prepare && electron electron/main.mjs",
    "desktop:smoke": "pnpm desktop:prepare && electron electron/main.mjs --smoke-test",
    "skills:test": "pnpm desktop:prepare && node scripts/test-product-behavior.mjs && node scripts/test-document-import.mjs && node scripts/test-pdf-tip-anchors.mjs && node scripts/test-nested-tips.mjs && node scripts/test-python.mjs && node scripts/test-advanced-skills.mjs && node scripts/test-skills-integration.mjs",
    "desktop:dist:win": "pnpm desktop:prepare && electron-builder --win nsis --x64",
    "desktop:dist:mas": "pnpm desktop:prepare && electron-builder --mac mas --universal",
    "desktop:dist:mas-dev": "pnpm desktop:prepare && electron-builder --mac mas-dev --universal"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.5.207",
    "pyodide": "314.0.3",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "bcryptjs": "3.0.3",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.28.0",
    "mammoth": "1.12.0",
    "marked": "18.0.7",
    "multer": "2.2.0",
    "openai": "7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.aitip.reader",
    "productName": "AI Tip",
    "asar": true,
    "asarUnpack": [
      "node_modules/pyodide/**/*",
      "node_modules/tesseract.js/dist/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/chi_sim/4.0.0_best_int/**/*",
      "node_modules/@tesseract.js-data/eng/4.0.0_best_int/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "scripts/fixtures/*.base64",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "mas",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist"
    },
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist"
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "tesseract.js"
    ]
  }
}
