# 仅服务端读取。浏览器无法访问该密钥。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
JWT_SECRET=replace-with-a-long-random-string
PORT=8787
# Supabase 已默认连接到 AI_reading_helper；publishable key 可安全随桌面端发布，
# 真正的数据隔离由服务端 JWT 校验、GRANT 与 RLS 共同保证。以下仅用于开发覆盖。
# AI_TIP_SUPABASE_ENABLED=0
# AI_TIP_SUPABASE_URL=https://kaqonqxygajosgddhmaq.supabase.co
# AI_TIP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 编译进桌面界面的公开官网地址；不能包含密钥。
# VITE_AI_TIP_PUBLIC_SITE_URL=https://example.com

# delete-account Edge Function 的 SUPABASE_URL、SUPABASE_ANON_KEY 与
# SUPABASE_SERVICE_ROLE_KEY 只在 Supabase 项目 Secrets 中配置，禁止写入本文件、
# Electron 包、Git 仓库或 App Store 审核说明。
